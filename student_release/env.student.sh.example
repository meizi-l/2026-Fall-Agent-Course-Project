#!/usr/bin/env bash
# Copy this file to env.student.local.sh, edit the values, then run:
#   source env.student.local.sh
#
# Do not submit env.student.local.sh.

# Required for real LLM-backed official runs. Replace these three values.
export COURSE_API_KEY="${COURSE_API_KEY:-replace-with-your-course-api-key}"
export AZURE_OPENAI_ENDPOINT="${AZURE_OPENAI_ENDPOINT:-https://example.openai.azure.com}"
export AZURE_OPENAI_API_VERSION="${AZURE_OPENAI_API_VERSION:-2025-02-01-preview}"

# Student agent model and limits. These defaults match task_configs/public_cases.json.
export COURSE_LLM_MODEL="${COURSE_LLM_MODEL:-gpt-5-mini}"
export COURSE_LLM_TIMEOUT_SEC="${COURSE_LLM_TIMEOUT_SEC:-300}"
export COURSE_LLM_MAX_INPUT_TOKENS="${COURSE_LLM_MAX_INPUT_TOKENS:-64000}"
export COURSE_LLM_MAX_OUTPUT_TOKENS="${COURSE_LLM_MAX_OUTPUT_TOKENS:-4096}"
export COURSE_LLM_MAX_ATTEMPTS="${COURSE_LLM_MAX_ATTEMPTS:-2}"

# Provider variables consumed by the starter agent runtime.
export AZURE_OPENAI_DEPLOYMENT="${AZURE_OPENAI_DEPLOYMENT:-$COURSE_LLM_MODEL}"
export AZURE_OPENAI_API_KEY="${AZURE_OPENAI_API_KEY:-$COURSE_API_KEY}"

# Provider variables consumed by tau2/LiteLLM and inherited by subprocesses.
# These intentionally override stale shell values so the student agent and
# environment user simulator share COURSE_API_KEY.
export OPENAI_API_KEY="$COURSE_API_KEY"
export AZURE_API_KEY="$COURSE_API_KEY"
export AZURE_API_BASE="$AZURE_OPENAI_ENDPOINT"
export AZURE_API_VERSION="$AZURE_OPENAI_API_VERSION"

# Optional: set this when using an OpenAI-compatible relay/base URL.
# export OPENAI_BASE_URL="${OPENAI_BASE_URL:-https://api.openai.com/v1}"

# tau2 user simulator: same API key, smaller simulator model.
# Use the LiteLLM Azure provider form so the simulator uses the school Azure
# endpoint instead of the public OpenAI API.
export TAU2_REPO="${TAU2_REPO:-../third_party/tau2-bench}"
export TAU2_USER="${TAU2_USER:-user_simulator}"
export TAU2_USER_MODEL="azure/gpt-4o-mini"
export TAU2_USER_LLM_ARGS="${TAU2_USER_LLM_ARGS:-{\"temperature\":0.0,\"timeout\":300}}"
export TAU2_MAX_STEPS="${TAU2_MAX_STEPS:-40}"
export TAU2_TIMEOUT="${TAU2_TIMEOUT:-300}"

# Optional self-managed benchmark checkout paths. Defaults match the course
# third_party setup scripts when this file is sourced from student_release/.
# export DEEPPLANNING_REPO="${DEEPPLANNING_REPO:-../third_party/qwen-agent}"
# export MCPMARK_REPO="${MCPMARK_REPO:-../third_party/mcpmark}"
