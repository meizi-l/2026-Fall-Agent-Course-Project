#!/usr/bin/env bash
# Copy to env.student.local.sh, replace only COURSE_API_KEY, then run:
#   source env.student.local.sh
# Do not commit or submit env.student.local.sh.

# Required for real LLM-backed official runs: use an HKUST GenAI subscription key.
export COURSE_API_KEY="replace-with-your-hkust-genai-api-key"
export OPENAI_BASE_URL="https://hkust.azure-api.net/hkust-genai/v1"

# Course models: agent and tau2 user simulator share the service/key.
export COURSE_LLM_MODEL="gpt-5-mini"
export TAU2_USER_MODEL="openai/gpt-4o-mini"

# Limits come from task JSON via request.limits; keep course defaults.
# The runner supplies tau2's provider key and transport authentication.

# Optional self-managed benchmark checkout paths (absolute paths).
# Otherwise, the runner finds the course third_party checkouts automatically.
# export TAU2_REPO="/absolute/path/to/tau2-bench"
# export DEEPPLANNING_REPO="/absolute/path/to/qwen-agent"
# export MCPMARK_REPO="/absolute/path/to/mcpmark"
